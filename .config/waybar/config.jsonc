{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,
    "margin-top": 4,
    "margin-left": 4,
    "margin-right": 4,

    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "mpris",
        "clock"
    ],
    "modules-right": [
        "group/tray-expander",
        "power-profiles-daemon",
        "network",
        "pulseaudio",
        "battery",
        "custom/swaync"
    ],

// Modules

    "hyprland/workspaces": {
        // "format": "●",
        "format": {},
        "on-scroll-up": "hyprctl dispatch workspace r-1",
        "on-scroll-down": "hyprctl dispatch workspace r+1",
        "all-outputs": false,
        "active-only": false,
        "on-click": "activate"
    },
    "mpris": {
        "interval": 1,
        "format": "{player_icon} Playing",
        "format-paused": "{status_icon} Media",
        "tooltip": true,
        "tooltip-format": "{status_icon} {dynamic}\nLeft Click: previous\nMid Click: Pause\nRight Click: Next",
        "player-icons": {
        "chromium": "",
        "default": "",
        "firefox": "",
        "kdeconnect": "",
        "mopidy": "",
        "mpv": "󰐹",
        "spotify": "",
        "vlc": "󰕼"
    },
    "status-icons": {
      "paused": "󰐎",
      "playing": "",
      "stopped": ""
    },
        "status-icons": {
            "paused": "⏸"
        },
        "max-length": 50,
        "on-click": "playerctl previous",
        "on-click-middle": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "interval": 1
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Profil : {profile}\nPilote : {driver}",
        "tooltip": true,
        "format-icons": {
            "performance": "󱐋",
            "balanced":    "",
            "power-saver": "󰌪"
        }
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone":  "󰋋",
            "headset":    "󰋎",
            "default":    ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "tooltip": false
    },

    "network": {    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
        "on-click": "nm-connection-editor"
    },

    "cpu": {
        "format": "󰘚 {usage}%",
        "tooltip": false,
        "interval": 2
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
        "interval": 5
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-",
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged":  "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "clock": {
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰥔 {:%d/%m/%Y}",
        "tooltip-format": "<big>{:%A %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },

  "custom/exit": {
    "format": "",
    "on-click": "wlogout",
    "on-click-right": "hyprlock",
    "tooltip-format": "Left: Power menu\nRight: Lock screen"
  },

    "group/tray-expander": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 400,
            "children-class": "tray-group-item",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/expand-icon",
            "tray"
        ]
    },

    "custom/expand-icon": {
        "format": "",
        "tooltip": false
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/swaync": {
        "tooltip": false,
        "format": "{}",
        "format-icons": {
            "notification":               "",
            "none":                       "",
            "dnd-notification":           "<span foreground='#f38ba8'></span>",
            "dnd-none":                   "",
            "inhibited-notification":     "<span foreground='#f38ba8'></span>",
            "inhibited-none":             "",
            "dnd-inhibited-notification": "<span foreground='#f38ba8'></span>",
            "dnd-inhibited-none":         ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    }
}


